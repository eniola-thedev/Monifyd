# Server-side canonical app URL; set to your public HTTPS URL in production.
APP_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Required to encrypt webhook signing secrets at rest; set to output from `openssl rand -base64 32`.
WEBHOOK_SIGNING_SECRET_PEPPER=
# Invoice emails (Resend). Leave blank to disable sending.
RESEND_API_KEY=
EMAIL_FROM="Monifyd <invoices@yourdomain.com>"
# Payment detection
CRON_SECRET=generate-a-long-random-string
# Optional: dedicated RPC endpoints (recommended in production). Public defaults are used if blank.
RPC_ETHEREUM=
RPC_BASE=
RPC_POLYGON=
RPC_BNB=
RPC_SOLANA=
BITCOIN_API=
# NGN subscriptions use Paystack; USD subscriptions use BACHS.
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_DASHBOARD_PRO_NGN_MONTHLY=
PAYSTACK_PLAN_DASHBOARD_PRO_NGN_ANNUALLY=
PAYSTACK_PLAN_DASHBOARD_BUSINESS_NGN_MONTHLY=
PAYSTACK_PLAN_DASHBOARD_BUSINESS_NGN_ANNUALLY=
PAYSTACK_PLAN_API_GROWTH_NGN_MONTHLY=
PAYSTACK_PLAN_API_GROWTH_NGN_ANNUALLY=
PAYSTACK_PLAN_API_SCALE_NGN_MONTHLY=
PAYSTACK_PLAN_API_SCALE_NGN_ANNUALLY=
# BACHS handles USD recurring subscriptions.
BACHS_ENVIRONMENT=production
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# Configure each product in the BACHS catalog with the matching price and recurring interval.
BACHS_PRODUCT_DASHBOARD_PRO_USD_MONTHLY=
BACHS_PRODUCT_DASHBOARD_PRO_USD_ANNUALLY=
BACHS_PRODUCT_DASHBOARD_BUSINESS_USD_MONTHLY=
BACHS_PRODUCT_DASHBOARD_BUSINESS_USD_ANNUALLY=
BACHS_PRODUCT_API_GROWTH_USD_MONTHLY=
BACHS_PRODUCT_API_GROWTH_USD_ANNUALLY=
BACHS_PRODUCT_API_SCALE_USD_MONTHLY=
BACHS_PRODUCT_API_SCALE_USD_ANNUALLY=
